{
  "name": "V2Leafy Codespace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "overrideCommand": true,
  "remoteUser": "root",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "V2Leafy Panel, Subscription & VLESS",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "TERM": "xterm-256color",
    "PYTHONUNBUFFERED": "1",
    "PORT": "8080"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "gh auth status || true",
  "postAttachCommand": "python main.py"
}
